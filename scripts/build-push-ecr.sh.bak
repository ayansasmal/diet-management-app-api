#!/bin/bash
# =============================================================================
# Build and Push Docker Image to Amazon ECR
# =============================================================================
# Prerequisites:
#   - Docker installed and running
#   - AWS CLI configured
#   - ECR repository created
#
# Usage:
#   ./scripts/build-push-ecr.sh [command]
#
# Commands:
#   create-repo   - Create ECR repository
#   build         - Build Docker image (multi-arch: amd64 + arm64)
#   push          - Push to ECR
#   all           - Create repo, build, and push
# =============================================================================

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
AWS_REGION="${AWS_REGION:-ap-southeast-2}"
IMAGE_NAME="diet-api"
IMAGE_TAG="${IMAGE_TAG:-latest}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="${SCRIPT_DIR}/.."

# Helper functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Get AWS Account ID
get_account_id() {
    aws sts get-caller-identity --query Account --output text
}

# Get ECR URL
get_ecr_url() {
    local ACCOUNT_ID=$(get_account_id)
    echo "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
}

# Check prerequisites
check_prerequisites() {
    log_info "Checking prerequisites..."

    # Check Docker
    if ! command -v docker &> /dev/null; then
        log_error "Docker not found. Please install Docker."
        exit 1
    fi

    # Check Docker is running
    if ! docker info &> /dev/null; then
        log_error "Docker is not running. Please start Docker Desktop."
        exit 1
    fi

    # Check AWS CLI
    if ! command -v aws &> /dev/null; then
        log_error "AWS CLI not found. Please install AWS CLI."
        exit 1
    fi

    # Check AWS credentials
    if ! aws sts get-caller-identity &> /dev/null; then
        log_error "AWS credentials not configured. Run 'aws configure'."
        exit 1
    fi

    log_success "Prerequisites check passed"
}

# Create ECR repository
create_ecr_repo() {
    log_info "Creating ECR repository..."

    # Check if repository exists
    if aws ecr describe-repositories --repository-names ${IMAGE_NAME} \
        --region ${AWS_REGION} &> /dev/null; then
        log_info "Repository '${IMAGE_NAME}' already exists"
        return 0
    fi

    # Create repository
    aws ecr create-repository \
        --repository-name ${IMAGE_NAME} \
        --region ${AWS_REGION} \
        --image-scanning-configuration scanOnPush=true \
        --image-tag-mutability MUTABLE

    # Add lifecycle policy to clean up old images
    aws ecr put-lifecycle-policy \
        --repository-name ${IMAGE_NAME} \
        --region ${AWS_REGION} \
        --lifecycle-policy-text '{
            "rules": [
                {
                    "rulePriority": 1,
                    "description": "Keep last 5 images",
                    "selection": {
                        "tagStatus": "any",
                        "countType": "imageCountMoreThan",
                        "countNumber": 5
                    },
                    "action": {
                        "type": "expire"
                    }
                }
            ]
        }'

    log_success "ECR repository created: ${IMAGE_NAME}"
}

# Login to ECR
ecr_login() {
    log_info "Logging into ECR..."

    local ECR_URL=$(get_ecr_url)

    aws ecr get-login-password --region ${AWS_REGION} | \
        docker login --username AWS --password-stdin ${ECR_URL}

    log_success "Logged into ECR"
}

# Build Docker image for ARM64 (t4g instances)
build_image() {
    log_info "Building Docker image for ARM64..."

    cd "${BACKEND_DIR}"

    local ECR_URL=$(get_ecr_url)
    local FULL_IMAGE="${ECR_URL}/${IMAGE_NAME}:${IMAGE_TAG}"

    # Check if buildx is available
    if docker buildx version &> /dev/null; then
        log_info "Using Docker Buildx for multi-platform build..."

        # Create builder if not exists
        if ! docker buildx inspect diet-builder &> /dev/null; then
            docker buildx create --name diet-builder --use
        else
            docker buildx use diet-builder
        fi

        # Build for ARM64 (primary target) and optionally AMD64
        docker buildx build \
            --platform linux/arm64 \
            --tag ${FULL_IMAGE} \
            --push \
            .

        log_success "Image built and pushed: ${FULL_IMAGE}"
    else
        log_warn "Docker Buildx not available. Building for local platform only."

        # Standard build (will work if running on ARM64 Mac)
        docker build \
            --tag ${FULL_IMAGE} \
            .

        log_success "Image built: ${FULL_IMAGE}"
        log_info "Run 'push' command to push to ECR"
    fi
}

# Push image to ECR
push_image() {
    log_info "Pushing image to ECR..."

    ecr_login

    local ECR_URL=$(get_ecr_url)
    local FULL_IMAGE="${ECR_URL}/${IMAGE_NAME}:${IMAGE_TAG}"

    # Check if image exists locally
    if ! docker image inspect ${FULL_IMAGE} &> /dev/null; then
        log_error "Image not found locally. Run 'build' first."
        exit 1
    fi

    docker push ${FULL_IMAGE}

    log_success "Image pushed: ${FULL_IMAGE}"
}

# Build and push
build_and_push() {
    check_prerequisites
    create_ecr_repo
    ecr_login
    build_image

    echo ""
    log_success "=== Build and Push Complete ==="
    local ECR_URL=$(get_ecr_url)
    log_info "Image: ${ECR_URL}/${IMAGE_NAME}:${IMAGE_TAG}"
    echo ""
    log_info "To deploy to EC2, use this image URL in your Docker run command"
}

# Show image info
show_info() {
    local ACCOUNT_ID=$(get_account_id)
    local ECR_URL=$(get_ecr_url)

    echo ""
    log_info "=== ECR Image Information ==="
    echo ""
    echo "AWS Account ID: ${ACCOUNT_ID}"
    echo "AWS Region: ${AWS_REGION}"
    echo "ECR URL: ${ECR_URL}"
    echo "Image Name: ${IMAGE_NAME}"
    echo "Full Image: ${ECR_URL}/${IMAGE_NAME}:${IMAGE_TAG}"
    echo ""

    # List images in repository
    log_info "Images in repository:"
    aws ecr describe-images \
        --repository-name ${IMAGE_NAME} \
        --region ${AWS_REGION} \
        --query 'imageDetails[*].{Tag:imageTags[0],Size:imageSizeInBytes,Pushed:imagePushedAt}' \
        --output table 2>/dev/null || echo "Repository not found or empty"
}

# Main
case "${1:-all}" in
    create-repo)
        check_prerequisites
        create_ecr_repo
        ;;
    build)
        check_prerequisites
        ecr_login
        build_image
        ;;
    push)
        check_prerequisites
        push_image
        ;;
    all)
        build_and_push
        ;;
    info)
        check_prerequisites
        show_info
        ;;
    *)
        echo "Usage: $0 {create-repo|build|push|all|info}"
        echo ""
        echo "Environment variables:"
        echo "  AWS_REGION   - AWS region (default: ap-southeast-2)"
        echo "  IMAGE_TAG    - Docker image tag (default: latest)"
        exit 1
        ;;
esac
