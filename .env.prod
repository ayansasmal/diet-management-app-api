# Production Environment Variables
# Used by: ./scripts/deploy-aws.sh
#
# These values are read from environment variables.
# Set them in your shell or CI/CD pipeline before running deploy-aws.sh
#
# Example:
#   export GOOGLE_CLIENT_ID="your-client-id"
#   export GOOGLE_CLIENT_SECRET="your-client-secret"
#   export GITHUB_TOKEN="ghp_your_token"
#   ./scripts/deploy-aws.sh all

# Google OAuth - reads from environment, falls back to these defaults
GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID:-}"
GOOGLE_CLIENT_SECRET="${GOOGLE_CLIENT_SECRET:-}"

# GitHub Token for GHCR access - reads from environment
GITHUB_TOKEN="${GITHUB_TOKEN:-}"

# Note: These are set dynamically by deploy-aws.sh:
# - DATABASE_URL: Built from RDS endpoint + password
# - JWT_SECRET: Auto-generated if not set
